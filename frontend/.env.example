# --- Адрес бэкенда -----------------------------------------------------------
# Базовый адрес API techline вместе с префиксом /api (он же basePath в swagger).
#
# Переменная НЕ имеет префикса NEXT_PUBLIC_ намеренно: браузер с бэкендом
# напрямую не разговаривает. Серверные компоненты ходят на этот адрес сами,
# а запросы из браузера идут на /api/proxy/* — то есть на тот же сервер Next.js,
# который уже подставляет токен и пересылает запрос дальше.
# Побочный плюс: нет CORS и адрес бэкенда не виден в клиентском бандле.
API_BASE_URL=http://localhost:8000/api

# --- Хранилище фотографий ----------------------------------------------------
# База для адресов фотографий машин. Бэкенд отдаёт в поле `path` путь внутри
# хранилища («machines/xe215c-1.jpg»), а не готовый URL, и адрес хранилища
# в API нигде не описан — отсюда отдельная переменная.
#
# Префикс NEXT_PUBLIC_ здесь уместен: это публичный адрес CDN, его подставляет
# тег <img> прямо в браузере. Пока переменная пуста, вместо фотографий
# показывается заглушка, и витрина не разваливается.
NEXT_PUBLIC_MEDIA_BASE_URL=

# --- Обновление снимка контракта (только для разработки) ---------------------
# Откуда `npm run sync:spec` копирует swagger.json бэкенда.
# В CI не используется: там типы генерируются из снимка openapi/swagger.json.
CATALOG_SWAGGER_SOURCE=../backend/swagger/swagger.json
