{
  "name": "techline-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:api && next build",
    "start": "next start",
    "sync:spec": "node --env-file-if-exists=.env.local scripts/sync-spec.mjs",
    "gen:api": "node scripts/gen-api.mjs",
    "check:api": "node scripts/check-api.mjs",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.35.0",
